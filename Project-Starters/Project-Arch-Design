    %% CI/CD
    %% =========================
    GH[GitHub Repository]
    GHA[GitHub Actions<br/>.github/workflows/]
    TEST[pytest]
    DOCKER[Docker Build<br/>Dockerfile]
    GHCR[GitHub Container Registry]
    RUN[Docker Runtime]

    GH --> GHA
    GHA --> TEST
    GHA --> DOCKER
    DOCKER --> GHCR
    GHCR --> RUN
    RUN --> FE

