    S1[Incident Schema<br/>schemas/incident_schema.py]

    LOGS --> A1
    P1 --> A1
    ORCH --> A1
    A1 --> S1

    %% =========================
    %% AGENT 2
    %% =========================
    A2[Agent 2 - Runbook Investigator<br/>agents/runbook_investigator.py]
    P2[System Prompt<br/>prompts/runbook_investigator_prompt.txt]
    KB[Bedrock Knowledge Base]
    DOCS[Runbooks / Known Issues / Architecture Docs<br/>knowledge/]
    RET[KB Retriever<br/>utils/kb_retriever.py]
    S2[Recommendation Schema<br/>schemas/recommendation_schema.py]

    S1 --> A2
    P2 --> A2
    DOCS --> KB
    KB --> RET
    RET --> A2
    A2 --> S2

    %% =========================
    %% AGENT 3
    %% =========================
    A3[Agent 3 - Response Coordinator<br/>agents/response_coordinator.py]
    P3[System Prompt<br/>prompts/response_coordinator_prompt.txt]
    S3[Decision Schema<br/>schemas/decision_schema.py]

    S1 --> A3
    S2 --> A3
    P3 --> A3
    A3 --> S3

    %% =========================
    %% ACTION / TOOL
    %% =========================
    LC[Lambda Client<br/>utils/lambda_client.py]
    ACTION[Create Incident Action<br/>actions/create_incident.py]
    LAMBDA[AWS Lambda]
    RESULT[Incident Record / Response]

    S3 --> LC
    LC --> LAMBDA
    LAMBDA --> ACTION
    ACTION --> RESULT
    RESULT --> ORCH
    ORCH --> FE

    %% =========================
    %% BEDROCK
    %% =========================
    BEDROCK[AWS Bedrock]

    A1 --> BEDROCK
    A2 --> BEDROCK
    A3 --> BEDROCK

    %% =========================
    %% INFRASTRUCTURE
    %% =========================
    TF[Terraform<br/>terraform/]
    S3AWS[S3]
    IAM[IAM]
    CW[CloudWatch]

    TF --> S3AWS
    TF --> IAM
    TF --> LAMBDA
    TF --> KB
    TF --> CW

