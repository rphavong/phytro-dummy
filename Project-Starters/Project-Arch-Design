    %% =========================
    U[User / Operator]
    FE[Streamlit Front End<br/>app/streamlit_app.py]

    U --> FE

    %% =========================
    %% ORCHESTRATION
    %% =========================
    ORCH[Workflow Orchestrator<br/>orchestrator/workflow.py]

    FE --> ORCH

